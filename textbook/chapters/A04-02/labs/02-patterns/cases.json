{
  "_comment": "第 09 讲实验 9-2：每个用例 = 一条事件模式 + 一条事件。base 是公共事件信封，event 中的字段会覆盖/合并到 base.detail。",
  "base": {
    "version": "0",
    "id": "6a7e8feb-b491-4cf7-a9f1-bf3703467718",
    "detail-type": "DeploymentAnomaly",
    "source": "cloudops.lab",
    "account": "111122223333",
    "time": "2026-11-17T09:03:00Z",
    "region": "us-east-1",
    "resources": [],
    "detail": {
      "service": "checkout",
      "release": "v2.3.1",
      "phase": "canary",
      "severity": "high",
      "errorRate": 75,
      "routes": ["/cart", "/checkout"],
      "clientIp": "10.0.0.17"
    }
  },
  "lab_pattern": {
    "source": ["cloudops.lab"],
    "detail-type": ["DeploymentAnomaly"],
    "detail": { "severity": ["high"] }
  },
  "cases": [
    { "id": "C01", "title": "完整命中本章规则", "pattern": "lab", "envelope": {}, "detail": {} },
    { "id": "C02", "title": "source 不同", "pattern": "lab", "envelope": { "source": "cloudops.other" }, "detail": {} },
    { "id": "C03", "title": "大小写不同：HIGH ≠ high", "pattern": "lab", "envelope": {}, "detail": { "severity": "HIGH" } },
    { "id": "C04", "title": "equals-ignore-case 忽略大小写",
      "pattern": { "detail": { "severity": [ { "equals-ignore-case": "high" } ] } }, "envelope": {}, "detail": { "severity": "HIGH" } },
    { "id": "C05", "title": "类型不同：字符串 \"500\" ≠ 数字 500",
      "pattern": { "detail": { "status": [500] } }, "envelope": {}, "detail": { "status": "500" } },
    { "id": "C06", "title": "数值范围 errorRate ≥ 50",
      "pattern": { "detail": { "errorRate": [ { "numeric": [">=", 50] } ] } }, "envelope": {}, "detail": {} },
    { "id": "C07", "title": "numeric 不匹配字符串形式的数字",
      "pattern": { "detail": { "errorRate": [ { "numeric": [">=", 50] } ] } }, "envelope": {}, "detail": { "errorRate": "75" } },
    { "id": "C08", "title": "数组求交集：routes 含 /checkout",
      "pattern": { "detail": { "routes": ["/checkout"] } }, "envelope": {}, "detail": {} },
    { "id": "C09", "title": "前缀 v2",
      "pattern": { "detail": { "release": [ { "prefix": "v2" } ] } }, "envelope": {}, "detail": {} },
    { "id": "C10", "title": "anything-but 列表",
      "pattern": { "detail": { "phase": [ { "anything-but": ["baseline", "rollback"] } ] } }, "envelope": {}, "detail": {} },
    { "id": "C11", "title": "anything-but 遇到缺失字段",
      "pattern": { "detail": { "ticket": [ { "anything-but": "closed" } ] } }, "envelope": {}, "detail": {} },
    { "id": "C12", "title": "exists:false 匹配缺失字段",
      "pattern": { "detail": { "ticket": [ { "exists": false } ] } }, "envelope": {}, "detail": {} },
    { "id": "C13", "title": "exists 用在对象（非叶子）上",
      "pattern": { "detail": [ { "exists": true } ] }, "envelope": {}, "detail": {} },
    { "id": "C14", "title": "$or：severity=high 或 errorRate ≥ 50",
      "pattern": { "detail": { "$or": [ { "severity": ["high"] }, { "errorRate": [ { "numeric": [">=", 50] } ] } ] } },
      "envelope": {}, "detail": { "severity": "medium" } },
    { "id": "C15", "title": "通配符 /check*",
      "pattern": { "detail": { "routes": [ { "wildcard": "/check*" } ] } }, "envelope": {}, "detail": {} },
    { "id": "C16", "title": "CIDR 10.0.0.0/24",
      "pattern": { "detail": { "clientIp": [ { "cidr": "10.0.0.0/24" } ] } }, "envelope": {}, "detail": {} },
    { "id": "C17", "title": "null 只匹配显式 null",
      "pattern": { "detail": { "owner": [null] } }, "envelope": {}, "detail": {} },
    { "id": "C18", "title": "null 匹配 \"owner\": null",
      "pattern": { "detail": { "owner": [null] } }, "envelope": {}, "detail": { "owner": null } },
    { "id": "C19", "title": "数字写法不同：500 与 500.0",
      "pattern": { "detail": { "status": [500] } }, "envelope": {}, "detail": { "status": 500.0 } },
    { "id": "C20", "title": "规则写在 detail 外层：severity 不在顶层",
      "pattern": { "severity": ["high"] }, "envelope": {}, "detail": {} }
  ]
}
